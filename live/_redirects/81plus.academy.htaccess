# Redirect per il dominio 81plus.academy verso la sua home in 81plus.net
# Copia questo come .htaccess nella cartella del dominio 81plus.academy se usi il parcheggio
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?81plus\\.academy$ [NC]
RewriteRule ^(.*)$ https://81plus.net/81plus.academy/$1 [R=301,L]
