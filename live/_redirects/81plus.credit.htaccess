# Redirect per il dominio 81plus.credit verso la sua home in 81plus.net
# Copia questo come .htaccess nella cartella del dominio 81plus.credit se usi il parcheggio
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?81plus\\.credit$ [NC]
RewriteRule ^(.*)$ https://81plus.net/81plus.credit/$1 [R=301,L]
